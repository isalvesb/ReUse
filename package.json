{
  "name": "reuse-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/mobile"],
  "packageManager": "npm@11.8.0",
  "engines": {"node": ">=22.14.0", "npm": ">=11.0.0"},
  "scripts": {
    "dev:web": "npm run dev --workspace=@reuse/web",
    "dev:mobile": "npm run start --workspace=@reuse/mobile",
    "test": "npm run test:web && npm run test:mobile",
    "test:web": "npm run test --workspace=@reuse/web",
    "test:mobile": "npm run test --workspace=@reuse/mobile",
    "lint:web": "npm run lint --workspace=@reuse/web",
    "typecheck:mobile": "npm run typecheck --workspace=@reuse/mobile",
    "generate:web": "npm exec --workspace=@reuse/web -- prisma generate",
    "build:web": "npm run build --workspace=@reuse/web -- --webpack",
    "build:mobile": "npm run bundle --workspace=@reuse/mobile",
    "check": "npm test && npm run lint:web && npm run typecheck:mobile"
  }
}
