SUPABASE_PUBLISHABLE_KEY=""
# Runtime role, not postgres/service_role. Set privately after explicit migration.
DATABASE_URL="postgresql://example_user:example_password@database.example.invalid:5432/example_db?schema=public"
RATE_LIMIT_SECRET=""
NEXT_PUBLIC_APP_URL="http://127.0.0.1:4330"
NEXT_PUBLIC_DISABLE_IBM_WEBCHAT="true"
NEXT_PUBLIC_SHOW_LEGACY_ASSISTANTS="false"
# Auth provider secret/service-role keys are not used by the application.
# Signup, password recovery, social login and avatar uploads are inactive.

# Somente servidor: chave secreta do projeto novo para Storage privado. Nunca EXPO_PUBLIC/NEXT_PUBLIC.
REUSE_STORAGE_SECRET=

# Work 1.14: real IBM only. Server-side values; never NEXT_PUBLIC/EXPO_PUBLIC.
REUSE_IBM_ENABLED=false
REUSE_IBM_API_KEY=
REUSE_IBM_CHAT_URL=
# YYYY-MM-DD from the IBM trial UI. Local calls stop at 00:00 UTC on this date
# as a conservative cutoff; this is not a claim about IBM's exact expiry time.
REUSE_IBM_TRIAL_END_DATE=
ASSISTANT_CONFIRMATION_SECRET=
